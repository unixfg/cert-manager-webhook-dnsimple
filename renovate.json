{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    "group:kubernetesMonorepo"
  ],
  "timezone": "America/Chicago",
  "schedule": [
    "* 0-11 * * *"
  ],
  "updateNotScheduled": false,
  "automerge": false,
  "automergeType": "pr",
  "automergeStrategy": "merge-commit",
  "platformAutomerge": true,
  "rebaseWhen": "conflicted",
  "ignoreTests": false,
  "internalChecksFilter": "strict",
  "prHourlyLimit": 4,
  "prConcurrentLimit": 2,
  "labels": [
    "dependencies"
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "addLabels": [
      "security"
    ],
    "schedule": [],
    "minimumReleaseAge": null,
    "updateNotScheduled": true,
    "groupName": null
  },
  "packageRules": [
    {
      "description": "Apply the release labels required by this repository's PR checks",
      "matchUpdateTypes": [
        "digest",
        "pin",
        "pinDigest",
        "patch",
        "lockFileMaintenance"
      ],
      "addLabels": [
        "patch"
      ]
    },
    {
      "matchUpdateTypes": [
        "minor"
      ],
      "addLabels": [
        "minor"
      ]
    },
    {
      "description": "Group routine GitHub Actions updates",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "digest",
        "pinDigest",
        "patch",
        "minor"
      ],
      "groupName": "github-actions"
    },
    {
      "description": "Wait 3 days when a Docker or Helm release timestamp is available",
      "matchDatasources": [
        "docker",
        "helm"
      ],
      "minimumReleaseAge": "3 days",
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    },
    {
      "description": "Keep major updates separate and require manual merging",
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": null,
      "automerge": false,
      "addLabels": [
        "major-update",
        "major"
      ]
    }
  ],
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/fixtures/**",
    "tmp/**"
  ],
  "forkProcessing": "enabled"
}
